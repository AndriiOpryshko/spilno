meta {
  name: Create meeting
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/governance/meetings
  body: json
  auth: none
}

body:json {
  {
    "title": "Sample title",
    "kind": "REGULAR",
    "held_at": "2026-01-15T10:00:00Z",
    "ends_at": "2026-01-15T10:00:00Z",
    "location": "Sample location",
    "quorum_required": false
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
}

script:post-response {
  bru.setVar("meetingId", res.body.id);
}
